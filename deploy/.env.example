# ─── Oxi Zap · Evolution API v2.3.7 ───────────────────────────────
# Copie para .env e preencha. NUNCA comite o .env.

# URL pública da API (o subdomínio que você apontar no DNS)
SERVER_URL=https://api.SEUDOMINIO.com.br

# Chave mestra da API — gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=TROQUE_AQUI
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

LANGUAGE=pt-BR
LOG_LEVEL=ERROR,WARN,INFO
# Não derrubar instância desconectada automaticamente
DEL_INSTANCE=false

# Nome que aparece no celular conectado
CONFIG_SESSION_PHONE_CLIENT=ZapConverte
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# ─── Banco (Postgres do compose) ─────────────────────────────────
POSTGRES_USER=oxizap
POSTGRES_PASSWORD=TROQUE_AQUI_SENHA_FORTE
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://oxizap:TROQUE_AQUI_SENHA_FORTE@postgres:5432/evolution_db?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=oxizap
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=false

# ─── Redis (do compose) ──────────────────────────────────────────
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ─── Webhook global (apontar pro app do Oxi Zap na Fase 1) ───────
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_REQUEST_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
