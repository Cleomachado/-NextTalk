# ZapConverte API — copie para .env e preencha
PORT=3333

# UazAPI (servidor + token da instância)
UAZAPI_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=coloque_o_instance_token_aqui

# Segredos dos webhooks das plataformas (preencha conforme for integrando)
KIWIFY_WEBHOOK_TOKEN=
HOTMART_HOTTOK=

# Anti-ban: atraso base entre passos + jitter aleatório (ms)
STEP_DELAY_MIN_MS=1500
STEP_DELAY_MAX_MS=4000
